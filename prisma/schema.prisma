// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  displayName  String
  birthYear    Int
  gender       String   // "male", "female", "non_binary", "prefer_not_to_say"
  createdAt    DateTime @default(now())
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  emailWeeklyActive   Boolean  @default(true)
  emailWelcomeSent    Boolean  @default(false)
  ratings             Rating[]
  feedbacks           Feedback[]
}

model Movie {
  id            String   @id @default(uuid())
  tmdbId        Int      @unique
  title         String
  originalTitle String
  year          Int
  synopsis      String
  posterUrl     String
  backdropUrl   String?
  director      String
  runtime       Int
  tmdbRating    Float?
  cast          String?
  cachedAt      DateTime @default(now())
  isFeatured    Boolean  @default(false)
  ratings       Rating[]
  genres        Genre[]
}

model Genre {
  id     String  @id @default(uuid())
  name   String  @unique
  movies Movie[]
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score        Int      // Valoración de 1 a 10
  isArtificial Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie        Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  category  String   // "suggestion" | "bug" | "other"
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

