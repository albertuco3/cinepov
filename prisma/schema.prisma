// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  displayName  String
  birthYear    Int
  gender       String   // "male", "female", "non_binary", "prefer_not_to_say"
  createdAt    DateTime @default(now())
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  emailWeeklyActive   Boolean  @default(true)
  emailWelcomeSent    Boolean  @default(false)
  // Verificación de email. Un voto solo entra en los agregados públicos si la
  // cuenta está verificada: es la barrera básica contra el review bombing.
  emailVerified       DateTime?
  // Cuenta anonimizada tras ejercer el derecho de supresión (RGPD). Las
  // valoraciones se conservan desvinculadas de la identidad del usuario.
  isAnonymized        Boolean  @default(false)
  // Última vez que se comprobaron los desbloqueos de granularidad para avisarle.
  lastUnlockCheck     DateTime?
  ratings             Rating[]
  watchlists          Watchlist[]
  feedbacks           Feedback[]
  tokens              VerificationToken[]
  reviewReports       ReviewReport[]
  lists               CustomList[]
  following           Follow[] @relation("Following")
  followers           Follow[] @relation("Followers")
  notifications       Notification[]
}

model Movie {
  id            String   @id @default(uuid())
  tmdbId        Int      @unique
  title         String
  originalTitle String
  year          Int
  synopsis      String
  posterUrl     String
  backdropUrl   String?
  director      String
  runtime       Int
  tmdbRating    Float?
  cast          String?
  cachedAt      DateTime @default(now())
  isFeatured    Boolean  @default(false)
  ratings       Rating[]
  watchlists    Watchlist[]
  genres        Genre[]
  listItems     ListItem[]
}

model Genre {
  id     String  @id @default(uuid())
  name   String  @unique
  movies Movie[]
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  score        Int      // Valoración de 1 a 10
  isArtificial Boolean  @default(false)
  // Fecha en que el usuario vio la película. Convierte la valoración puntual en
  // un diario de visionados, que es el hábito recurrente que genera retención.
  watchedAt    DateTime?
  // Reseña u opinión de texto libre opcional (hasta 2000 caracteres)
  reviewText   String?
  // Campos de moderación comunitaria (Fase 5.1.3)
  reportCount  Int      @default(0)
  isModerated  Boolean  @default(false)
  reports      ReviewReport[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie        Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
  // La agregación demográfica filtra siempre por isArtificial dentro de una
  // película: este índice compuesto es el que sostiene la consulta core.
  @@index([movieId, isArtificial])
  @@index([userId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  category  String   // "suggestion" | "bug" | "other"
  message   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Token de un solo uso para verificar el email o restablecer la contraseña.
/// Se almacena hasheado: una filtración de la base de datos no debe permitir
/// tomar el control de las cuentas.
model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  type      String   // "email_verification" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Contador de peticiones por clave y ventana temporal, persistido en base de
/// datos para que funcione en un entorno serverless con instancias efímeras.
model RateLimit {
  id          String   @id @default(uuid())
  key         String   @unique // "<acción>:<identificador>"
  count       Int      @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?

  @@index([windowStart])
}

model ReviewReport {
  id        String   @id @default(uuid())
  ratingId  String
  userId    String
  reason    String   // "offensive" | "spam" | "spoiler" | "other"
  details   String?
  createdAt DateTime @default(now())

  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ratingId, userId])
  @@index([ratingId])
}

model CustomList {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]

  @@index([userId])
}

model ListItem {
  id        String     @id @default(uuid())
  listId    String
  movieId   String
  order     Int        @default(0)
  addedAt   DateTime   @default(now())

  list      CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([listId, movieId])
  @@index([listId])
  @@index([movieId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "new_follower", "system"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

