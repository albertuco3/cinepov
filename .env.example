# ---------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ---------------------------------------------------------------------------
# SQLite no es válido en producción: el sistema de ficheros de Vercel es
# efímero y de solo lectura, así que cada despliegue perdería todos los datos.
#
# Opción recomendada: Neon (https://neon.tech), plan gratuito suficiente.
# Al crear el proyecto te dará dos cadenas de conexión; usa ambas:
#
#   DATABASE_URL -> la del POOL de conexiones (el host contiene "-pooler").
#                   Es la que usa la aplicación. Sin pooling, un pico de
#                   tráfico agota el límite de conexiones de la base de datos.
#   DIRECT_URL   -> la conexión DIRECTA (sin "-pooler").
#                   Solo la usan las migraciones de Prisma, que no funcionan
#                   a través de PgBouncer en modo transacción.
#
# Alternativa para desarrollo local con Docker:
#   docker run --name cinepov-db -e POSTGRES_PASSWORD=cinepov -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:cinepov@localhost:5432/postgres"
#   DIRECT_URL="postgresql://postgres:cinepov@localhost:5432/postgres"
DATABASE_URL="postgresql://usuario:contrasena@host-pooler.region.aws.neon.tech/cinepov?sslmode=verify-full"
DIRECT_URL="postgresql://usuario:contrasena@host.region.aws.neon.tech/cinepov?sslmode=verify-full"

# API Key de TMDB (The Movie Database)
TMDB_API_KEY="tu_api_key_aqui"

# Configuración de NextAuth
# Puedes generar un secreto seguro ejecutando: openssl rand -base64 32
NEXTAUTH_SECRET="genera-uno-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Autenticación con Google (OAuth)
GOOGLE_CLIENT_ID="tu_google_client_id_aqui"
GOOGLE_CLIENT_SECRET="tu_google_client_secret_aqui"

# Envío de correo transaccional con Resend (https://resend.com)
# Clave de API de Resend. Si se deja vacía o no se define, los correos NO se
# envían: se imprimen íntegros en la consola del servidor para poder trabajar en
# local sin credenciales (los enlaces de verificación y de restablecimiento de
# contraseña se pueden copiar desde ahí).
RESEND_API_KEY=""
# Remitente de los correos. El dominio debe estar verificado en Resend.
# Para pruebas puedes usar el remitente de cortesía: CinePOV <onboarding@resend.dev>
EMAIL_FROM="CinePOV <hola@tudominio.com>"

# Analitica con PostHog (opcional en desarrollo, cookieless por defecto)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Secreto de las tareas programadas (Vercel Cron lo envía como "Authorization: Bearer ...").
# Sin él, la ruta del email semanal se niega a ejecutarse. Genera uno con: openssl rand -base64 32
CRON_SECRET=""

# Emails de las cuentas administradoras (panel de moderación), separados por
# comas. La cuenta debe tener el email verificado. Vacío = nadie es administrador.
ADMIN_EMAILS=""
